# Safeguard Vision — Configurare prin variabile de mediu
# Copiază acest fișier ca .env și editează valorile.
# .env este gitignored (nu aparține la Git).

# === LICENȚĂ (cod de acces aplicație) ===
# Setează aceleași cod ca: python3 license.py --set COD
SAFEGUARD_LICENSE=schimba_ma

# === SESSION SECRET (generat automat dacă lipsește) ===
# Flask secret key — nu schimba dacă nu știi ce faci
# FLASK_SECRET_KEY=lasa_gol_pentru_autogenerare

# === TELEGRAM (notificări la severity=critical) ===
# Creează bot cu @BotFather, obține token, adaugă chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === EMAIL SMTP (notificări la severity=critical) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# === CORS (origin-urile permise pentru WebSocket) ===
# Separă cu virgulă. Include URL-ul loophole dacă folosești remote.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# === RETENȚIE CAPTURI (zile) ===
CAPTURE_RETENTION_DAYS=30
